<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The gateway's projects are checked for NativeAOT as they're written, not only at publish
         time. Tests aren't published, so they may use reflection. -->
    <IsAotCompatible Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src\'))">true</IsAotCompatible>
  </PropertyGroup>
</Project>
