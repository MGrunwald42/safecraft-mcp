{
  "id": "filmcraft",
  "display": "FilmCraft",
  "repo": "storytold/filmcraft",
  "binary": "filmcraft-cli.exe",
  "search": [
    "{repos}/filmcraft/target/release",
    "{ProgramFiles}/FilmCraft"
  ],
  "args": [
    "mcp",
    "--data-dir",
    "{profile}"
  ],
  "env": {},
  "ready": false,
  "callTimeoutSeconds": 300,
  "import": [
    "fcproj",
    "xml",
    "fcpxml",
    "aaf",
    "edl",
    "otio",
    "cube",
    "3dl",
    "mp4",
    "m4v",
    "mov",
    "mxf",
    "mts",
    "m2ts",
    "ts",
    "mpg",
    "mkv",
    "webm",
    "png",
    "jpg",
    "jpeg",
    "tif",
    "tiff",
    "bmp",
    "gif",
    "webp",
    "dpx",
    "tga"
  ],
  "export": [
    "fcproj",
    "mp4",
    "mov",
    "mxf",
    "xml",
    "fcpxml",
    "aaf",
    "omf",
    "edl",
    "otio",
    "ale",
    "csv",
    "png",
    "jpg",
    "jpeg",
    "tif",
    "tiff",
    "bmp",
    "gif",
    "dpx",
    "tga",
    "exr"
  ],
  "maxFileMb": 16384
}
